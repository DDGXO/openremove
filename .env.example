# OpenRemove Configuration

# Port configuration (Web Gateway: 3000, Model Server: 5000)
PORT=3000

# Backend Model Engine URL
# Uncomment to run the web gateway in decoupled mode
# Default (standalone): local isolated worker inference
# BACKEND_URL=http://localhost:5000

# ONNX Model Path (Optional, defaults to ./models/model.onnx)
MODEL_PATH=

# ----- Security / Hardening -----
# Comma-separated list of allowed CORS origins (exact host match).
# If empty, cross-origin browser access is disabled (same-origin only).
ALLOWED_ORIGINS=

# Maximum image pixel count accepted for processing (default: 40 MP)
MAX_IMAGE_PIXELS=41943040

# Temp file lifetime in minutes before automatic cleanup (default: 30)
TMP_FILE_TTL_MIN=30

# Job entry lifetime in minutes before eviction (default: 15)
JOB_TTL_MIN=15

# Maximum number of queued inferences before rejecting with 503 (default: 50)
MAX_QUEUE=50

